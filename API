const express = require("express")
const app = express()
const port  = 3000
app.use(express.json())

app.get("/ola", (req,res) => {
    res.json({resposta : "Olá mundo"})
})

app.get("/perfil", (req,res) => {
    res.json({resposta : "Maria" , idade : "15"})
})

app.listen(port,()=>{
    console.log("API rodando na porta" + port)
})
